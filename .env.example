# Copiá este archivo a `.env` (git lo ignora) y completá los valores.
# docker-compose lo lee automáticamente desde la raíz del proyecto.

# Secreto HS256 del JWT (mínimo 32 bytes). Cambialo para cualquier cosa que no sea tu máquina.
JWT_SECRET=dev-only-secret-change-me-marketplace-huila-32bytes+

# Origen público desde el que abrís la app en el navegador. Tiene que coincidir
# EXACTO con lo que escribís en la barra de direcciones (usá localhost, no 127.0.0.1).
# Cambia el CORS del backend, el allowed-origin del WebSocket y la URL de retorno de Stripe.
PUBLIC_BASE_URL=http://localhost:8080

# Stripe test mode (Épica 4). Sin esto, POST /api/transactions responde 502.
# `stripe listen --forward-to localhost:8080/api/transactions/webhook/stripe` imprime el whsec_.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
